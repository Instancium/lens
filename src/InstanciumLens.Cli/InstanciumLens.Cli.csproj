  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InstanciumLens.Core\InstanciumLens.Core.csproj" />
    <ProjectReference Include="..\InstanciumLens.Infrastructure\InstanciumLens.Infrastructure.csproj" />
    <ProjectReference Include="..\InstanciumLens.AI\InstanciumLens.AI.csproj" />
