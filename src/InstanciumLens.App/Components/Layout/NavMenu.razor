@* InstanciumLens.App/Components/Layout/NavMenu.razor *@
@implements IDisposable
@using InstanciumLens.AI.Downloader
@using InstanciumLens.AI.Configuration
@inject ModelProvisioning ProvisioningService

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <!-- Main Chat / Audit Interface -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Audit Chat
            </NavLink>
        </div>

        <!-- Offline AI Engine Status & Provisioning -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="engine">
                <span class="bi bi-cpu-fill" aria-hidden="true"></span> AI Engine

                @if (ProvisioningService.IsModelReady)
                {
                    <span class="badge" style="margin-left: 8px; background-color: #2e7d32; font-size: 0.7em;">Ready</span>
                }
                else
                {
                    <span class="badge" style="margin-left: 8px; background-color: #d32f2f; font-size: 0.7em;">Downloading</span>
                }
            </NavLink>
        </div>

    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        // 1. Subscribe to real-time changes
        ProvisioningService.OnProgressChanged += UpdateUI;

        // 2. Do an instant check when the app loads so the menu knows the state immediately
        ProvisioningService.EvaluateModelStatus(
            ModelSettings.FileName,
            ModelSettings.ExpectedSizeBytes);
    }

    private void UpdateUI()
    {
        // Re-renders the menu when the status changes (e.g., download finishes)
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ProvisioningService.OnProgressChanged -= UpdateUI;
    }
}