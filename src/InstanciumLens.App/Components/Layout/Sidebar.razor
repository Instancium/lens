@using InstanciumLens.AI.Downloader
@using InstanciumLens.AI.Configuration
@inject HttpClient HttpClient

<aside class="sidebar @(IsCollapsed ? "sidebar--collapsed" : "")">
    <div class="sidebar__header">
        <div class="sidebar__logo">
            <svg class="sidebar__logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
            </svg>
            @if (!IsCollapsed)
            {
                <span class="sidebar__title">Instancium Lens</span>
            }
        </div>
        <button class="sidebar__toggle" @onclick="ToggleSidebar" aria-label="Toggle sidebar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                @if (IsCollapsed)
                {
                    <polyline points="9 18 15 12 9 6"></polyline>
                }
                else
                {
                    <polyline points="15 18 9 12 15 6"></polyline>
                }
            </svg>
        </button>
    </div>

    @if (!IsCollapsed)
    {
        <div class="sidebar__content">
            <div class="sidebar__section">
                <h3 class="sidebar__section-title">System Status</h3>
                <div class="system-status">
                    <div class="system-status__item">
                        <div class="system-status__icon @(modelProvisioning.IsModelReady ? "system-status__icon--ready" : "system-status__icon--downloading")">
                            @if (modelProvisioning.IsModelReady)
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            }
                            else if (isDownloading)
                            {
                                <svg class="spin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="8" x2="12" y2="12"></line>
                                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                </svg>
                            }
                        </div>
                        <div class="system-status__info">
                            <span class="system-status__label">Local LLM (Qwen 8B)</span>
                            <span class="system-status__value">
                                @if (modelProvisioning.IsModelReady)
                                {
                                    <span>Ready to use</span>
                                }
                                else if (isDownloading)
                                {
                                    <span>Downloading... @modelProvisioning.Percent.ToString("F1")%</span>
                                }
                                else if (!string.IsNullOrEmpty(errorMessage))
                                {
                                    <span style="color: var(--color-error)">Error occurred</span>
                                }
                                else
                                {
                                    <span>Not started</span>
                                }
                            </span>
                        </div>
                    </div>

                    @if (!modelProvisioning.IsModelReady)
                    {


                        @if (!isDownloading && string.IsNullOrEmpty(errorMessage))
                        {
                            <button class="btn btn--primary btn--small" @onclick="StartDownload" style="margin-top: 12px; width: 100%;">
                                Start Download
                            </button>
                        }

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="system-status__error" style="margin-top: 12px; padding: 12px; background: rgba(239, 68, 68, 0.1); border-radius: 6px; border-left: 3px solid #EF4444;">
                                <div style="font-size: 11px; color: var(--color-error); margin-bottom: 8px; font-weight: 600;">Download Failed</div>
                                <div style="font-size: 11px; color: var(--color-error);">@errorMessage</div>
                                <button class="btn btn--primary btn--small" @onclick="StartDownload" style="margin-top: 8px; width: 100%; font-size: 11px;">
                                    Retry Download
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="sidebar__footer">
            <button class="sidebar__menu-item">
                <svg class="sidebar__menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
                <span>Settings</span>
            </button>

            <button class="sidebar__menu-item">
                <svg class="sidebar__menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span>About</span>
            </button>

            <div class="sidebar__version">
                <span>v0.1.0 Offline</span>
            </div>
        </div>
    }
</aside>
@code {
    [Parameter] public bool IsCollapsed { get; set; } = false;
    [Parameter] public EventCallback<bool> IsCollapsedChanged { get; set; }

    private ModelProvisioning modelProvisioning = default!;
    private bool isDownloading = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            modelProvisioning = new ModelProvisioning(HttpClient);

            modelProvisioning.EvaluateModelStatus(
                ModelSettings.FileName,
                ModelSettings.ExpectedSizeBytes
            );

            modelProvisioning.OnProgressChanged += OnModelProgressChanged;

            if (!modelProvisioning.IsModelReady)
            {
                await StartDownload();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Ошибка инициализации: {ex.Message}";
        }
    }

    private async Task StartDownload()
    {
        errorMessage = null;
        isDownloading = true;
        StateHasChanged();

        modelProvisioning.StartDownloadIfNotRunning(
            ModelSettings.DownloadUrl,
            ModelSettings.FileName,
            ModelSettings.ExpectedSizeBytes
        );

        await Task.Delay(100);
    }

    private void OnModelProgressChanged()
    {
        if (modelProvisioning.IsModelReady)
        {
            isDownloading = false;
            errorMessage = null;
        }
        else if (!string.IsNullOrEmpty(modelProvisioning.ErrorMessage))
        {
            isDownloading = false;
            errorMessage = modelProvisioning.ErrorMessage;
        }
        else if (modelProvisioning.Percent > 0 && modelProvisioning.Percent < 100)
        {
            isDownloading = true;
            errorMessage = null;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (modelProvisioning != null)
        {
            modelProvisioning.OnProgressChanged -= OnModelProgressChanged;
        }
    }

    private async Task ToggleSidebar()
    {
        IsCollapsed = !IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }
}