@using InstanciumLens.AI.Services
@inject GatewaySessionManager SessionManager
@implements IDisposable

<div class="sidebar @(IsCollapsed ? "collapsed sidebar--collapsed" : string.Empty)">
    <div class="sidebar-header">
        <h3 class="app-title">InstanciumLens</h3>
        <div class="gateway-status-container @GetStatusClass()">
            <span class="status-dot"></span>
            <span class="status-text">@GetStatusText()</span>
        </div>
    </div>

    <nav class="flex-column sidebar-nav">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door" aria-hidden="true"></span>
                @if (!IsCollapsed)
                {
                    <span class="nav-label">Home</span>
                }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="smart-interview">
                <span class="bi bi-chat-square-text" aria-hidden="true"></span>
                @if (!IsCollapsed)
                {
                    <span class="nav-label">Smart Interview</span>
                }
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="engine">
                <span class="bi bi-gear-fill" aria-hidden="true"></span>
                @if (!IsCollapsed)
                {
                    <span class="nav-label">Engine</span>
                }
            </NavLink>
        </div>
    </nav>
</div>

@code {
    /// <summary>
    /// Collapse flag supplied by MainLayout; restored after rewrite because the parent
    /// layout passes it as a component parameter and Blazor fails on unknown parameters.
    /// Both class names are applied so whichever selector exists in 04-sidebar.css wins.
    /// </summary>
    [Parameter]
    public bool IsCollapsed { get; set; }

    /// <summary>Supports two-way binding (@bind-IsCollapsed) if MainLayout uses it.</summary>
    [Parameter]
    public EventCallback<bool> IsCollapsedChanged { get; set; }

    private bool _subscribed;

    /// <summary>
    /// Defers gateway connection until after the first render so an unreachable
    /// gateway can never break circuit initialization.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_subscribed)
        {
            _subscribed = true;
            SessionManager.OnStatusChanged += HandleStatusChanged;
            try
            {
                await SessionManager.InitializeAsync();
            }
            catch
            {
                // Gateway offline at startup is a valid state, not a crash.
            }

            await InvokeAsync(StateHasChanged);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void HandleStatusChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetStatusClass()
    {
        return SessionManager.ConnectionState switch
        {
            Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected => "status-connected",
            Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Reconnecting => "status-reconnecting",
            Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connecting => "status-reconnecting",
            _ => "status-disconnected"
        };
    }

    private string GetStatusText()
    {
        return SessionManager.ConnectionState switch
        {
            Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connected => "AI Gateway Active",
            Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Reconnecting => "Reconnecting...",
            Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Connecting => "Connecting...",
            _ => "Gateway Offline"
        };
    }

    /// <summary>Unsubscribes from status events on disposal.</summary>
    public void Dispose()
    {
        SessionManager.OnStatusChanged -= HandleStatusChanged;
    }
}