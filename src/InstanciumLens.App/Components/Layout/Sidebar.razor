@inject NavigationManager Navigation


<div class="sidebar-container">
    <div class="sidebar-header">
        <img src="logo.png" alt="InstanciumLens" class="sidebar-logo" />
        <h4 class="sidebar-title">InstanciumLens</h4>
        <span class="sidebar-subtitle">v2.0 Gateway</span>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-item @(IsActive("") ? "active" : "")" @onclick='() => Navigate("")'>
            <span class="nav-icon">💬</span>
            <span class="nav-text">AI Assistant</span>
        </div>

        <div class="nav-item @(IsActive("knowledge") ? "active" : "")" @onclick='() => Navigate("knowledge")'>
            <span class="nav-icon">🧠</span>
            <span class="nav-text">Knowledge Graph</span>
        </div>

        <div class="nav-item @(IsActive("engine") ? "active" : "")" @onclick='() => Navigate("engine")'>
            <span class="nav-icon">⚙️</span>
            <span class="nav-text">Decision Engine</span>
        </div>

        <div class="nav-item @(IsActive("telemetry") ? "active" : "")" @onclick='() => Navigate("telemetry")'>
            <span class="nav-icon">📊</span>
            <span class="nav-text">Telemetry</span>
        </div>

        <div class="nav-item @(IsActive("settings") ? "active" : "")" @onclick='() => Navigate("settings")'>
            <span class="nav-icon">🛠️</span>
            <span class="nav-text">Settings</span>
        </div>
    </nav>

    <div class="sidebar-footer">
        <div class="connection-status">
            <span class="status-dot disconnected"></span>
            <span>Gateway Offline</span>
        </div>
    </div>
</div>

@code {
    private string? _currentPath;

    protected override void OnInitialized()
    {
        _currentPath = Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.Trim('/');
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentPath = Navigation.ToAbsoluteUri(e.Location).AbsolutePath.Trim('/');
        InvokeAsync(StateHasChanged);
    }

    private bool IsActive(string path)
    {
        if (string.IsNullOrEmpty(path) && string.IsNullOrEmpty(_currentPath)) return true;
        return _currentPath?.StartsWith(path, StringComparison.OrdinalIgnoreCase) ?? false;
    }

    private void Navigate(string path)
    {
        Navigation.NavigateTo(path);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}