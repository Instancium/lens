@* Components/Layout/Sidebar.razor *@
@using System.Reflection
@using System.Text.Json
@using InstanciumLens.AI.Configuration
@using InstanciumLens.AI.Contracts
@using InstanciumLens.AI.Services
@using InstanciumLens.Core.Interfaces
@using InstanciumLens.Core.Models
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Logging
@using Microsoft.Maui.Storage
@inject GatewayConnectionService ConnectionService
@inject GatewaySettings GatewaySettings
@inject NavigationManager NavManager
@inject IAppStateService AppState
@implements IDisposable

<div class="sidebar @(IsCollapsed ? "sidebar--collapsed" : "")">
    <div class="sidebar__header">
        <div class="sidebar__logo">
            <span class="sidebar__logo-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="18" r="3"></circle>
                    <circle cx="6" cy="6" r="3"></circle>
                    <circle cx="18" cy="6" r="3"></circle>
                    <path d="M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9"></path>
                    <path d="M12 12v3"></path>
                </svg>
            </span>
            @if (!IsCollapsed)
            {
                <span class="sidebar__title">Instancium Lens</span>
            }
        </div>
        <button type="button" class="sidebar__toggle" @onclick="ToggleCollapseAsync" title="Toggle sidebar">
            @if (IsCollapsed)
            {
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="13 17 18 12 13 7"></polyline>
                    <polyline points="6 17 11 12 6 7"></polyline>
                </svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="11 17 6 12 11 7"></polyline>
                    <polyline points="18 17 13 12 18 7"></polyline>
                </svg>
            }
        </button>
    </div>

    <div class="sidebar__content">
        <nav class="sidebar__nav">
            <div class="sidebar__section-title">Navigation</div>
            <a class="@GetNavClass("/")" @onclick="NavigateHome">
                <span class="sidebar__menu-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                </span>
                @if (!IsCollapsed)
                {
                    <span>Home</span>
                }
            </a>
            <a class="@GetNavClass("/smart-interview")" @onclick="NavigateSmartInterview">
                <span class="sidebar__menu-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                </span>
                @if (!IsCollapsed)
                {
                    <span>Smart Interview</span>
                }
            </a>
            <a class="@GetNavClass("/engine")" @onclick="NavigateEngine">
                <span class="sidebar__menu-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                        <rect x="9" y="9" width="6" height="6"></rect>
                        <path d="M9 1v3"></path>
                        <path d="M15 1v3"></path>
                        <path d="M9 20v3"></path>
                        <path d="M15 20v3"></path>
                        <path d="M1 9h3"></path>
                        <path d="M1 15h3"></path>
                        <path d="M20 9h3"></path>
                        <path d="M20 15h3"></path>
                    </svg>
                </span>
                @if (!IsCollapsed)
                {
                    <span>Engine</span>
                }
            </a>
        </nav>

        <div class="sidebar__profiles">
            <div class="sidebar__section-title">Graph Profiles</div>
            @if (profiles.Count == 0)
            {
                <div class="sidebar__empty">
                    <p>No graph profiles yet.</p>
                    <p class="sidebar__hint">Run Smart Interview to create the first profile.</p>
                </div>
            }
            else
            {
                @foreach (var profile in profiles)
                {
                    <button class="profile-card" @onclick="() => OpenProfile(profile)">
                        <span class="profile-card__icon">@GraphProfilePresentation.ResolveIcon(profile.Icon)</span>
                        <span class="profile-card__body">
                            <span class="profile-card__name">@GraphProfilePresentation.ResolveDisplayName(profile.DisplayName, profile.Id)</span>
                            <span class="profile-card__desc">@GraphProfilePresentation.ResolveDescription(profile.Description, string.Empty)</span>
                            <span class="profile-card__meta">@GetProfileMeta(profile)</span>
                        </span>
                    </button>
                }
            }
        </div>

        <div class="sidebar__section-title">System Status</div>
        <div class="system-status">
            <div class="system-status__item">
                <div class="@GetStatusIconClass()">
                    @switch (GetStatusKind())
                    {
                        case "ready":
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                                <polyline points="22 4 12 14.01 9 11.01"></polyline>
                            </svg>
                            break;
                        case "downloading":
                            <svg class="spin-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
                            </svg>
                            break;
                        case "error":
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="12"></line>
                                <line x1="12" y1="16" x2="12.01" y2="16"></line>
                            </svg>
                            break;
                        default:
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                            </svg>
                            break;
                    }
                </div>
                <div class="system-status__info">
                    <span class="system-status__label">@GetStatusText()</span>
                    <span class="system-status__value">@GetStatusValue()</span>
                </div>
            </div>
            @if (ShowDownloadProgress())
            {
                <div class="system-status__progress-bar">
                    <div class="system-status__progress-fill" style="width: @(GetDownloadPercent())%"></div>
                </div>
            }
        </div>
    </div>

    <div class="sidebar__footer">
        <button type="button" class="sidebar__menu-item" @onclick="ToggleSettings">
            <span class="sidebar__menu-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                </svg>
            </span>
            @if (!IsCollapsed)
            {
                <span>Settings</span>
            }
        </button>
        @if (!IsCollapsed)
        {
            <div class="sidebar__version">v@(AppVersion)</div>
        }
    </div>

    @if (showSettings)
    {
        <div class="sidebar__settings">
            <span class="sidebar__settings-label">Gateway Settings</span>
            <label class="sidebar__settings-label">Base URL</label>
            <input class="sidebar__settings-input" @bind="settingsBaseUrl" placeholder="http://localhost:5000" />
            <label class="sidebar__settings-label">API Key</label>
            <input class="sidebar__settings-input" @bind="settingsApiKey" type="password" placeholder="Enter API key" />
            <label class="sidebar__settings-label">Active Model (RepoId)</label>
            <input class="sidebar__settings-input" @bind="settingsRepoId" placeholder="qwen3-vl-8b-instruct" />
            <button type="button" class="sidebar__settings-save" @onclick="SaveSettingsAsync">Save</button>
            @if (settingsSaved)
            {
                <span class="sidebar__hint">@SettingsHint</span>
            }
        </div>
    }
</div>

@code {
    private const string BaseUrlPreferenceKey = "GatewayBaseUrl";
    private const string ApiKeyPreferenceKey = "GatewayApiKey";
    private const string RepoIdPreferenceKey = "GatewayActiveRepoId";

    [Parameter]
    public bool IsCollapsed { get; set; }

    [Parameter]
    public EventCallback<bool> IsCollapsedChanged { get; set; }

    private readonly List<GraphProfile> profiles = new();
    private bool showSettings;
    private bool settingsSaved;
    private string settingsBaseUrl = string.Empty;
    private string settingsApiKey = string.Empty;
    private string settingsRepoId = string.Empty;
    private bool _initialized;

    private static string AppVersion { get; } = ResolveAppVersion();

    private static string ResolveAppVersion()
    {
        Version? version = Assembly.GetExecutingAssembly().GetName().Version;
        if (version == null)
        {
            return "1.0.0";
        }

        return version.Revision > 0
            ? version.ToString()
            : $"{version.Major}.{version.Minor}.{version.Build}";
    }

    private string SettingsHint => settingsSaved
        ? "Settings saved. Restart the app to reconnect the gateway."
        : "Connection changes apply after app restart.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            ConnectionService.StateChanged += HandleConnectionStateChanged;
            NavManager.LocationChanged += OnLocationChanged;

            settingsBaseUrl = GatewaySettings.BaseUrl;
            settingsApiKey = GatewaySettings.ApiKey;
            settingsRepoId = GatewaySettings.ActiveRepoId;

            await ConnectionService.StartAsync();
            await LoadProfilesAsync();
            await InvokeAsync(StateHasChanged);
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose()
    {
        ConnectionService.StateChanged -= HandleConnectionStateChanged;
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private void HandleConnectionStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(LoadProfilesAsync);
    }

    [Inject]
    private Microsoft.Extensions.Logging.ILogger<Sidebar> Logger { get; set; } = default!;

    private async Task LoadProfilesAsync()
    {
        profiles.Clear();
        string? folder = AppState.CurrentFolderPath;
        if (!string.IsNullOrEmpty(folder))
        {
            try
            {
                string manifestPath = Path.Combine(folder, ".instancium", "manifest.json");
                if (File.Exists(manifestPath))
                {
                    string json = await File.ReadAllTextAsync(manifestPath);
                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    var manifest = JsonSerializer.Deserialize<FolderManifest>(json, options);
                    if (manifest?.Profiles != null)
                    {
                        profiles.AddRange(manifest.Profiles);
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Sidebar manifest read failed for {FolderPath}", folder);
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleCollapseAsync()
    {
        IsCollapsed = !IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }

    private void ToggleSettings()
    {
        showSettings = !showSettings;
        if (showSettings)
        {
            settingsBaseUrl = GatewaySettings.BaseUrl;
            settingsApiKey = GatewaySettings.ApiKey;
            settingsRepoId = GatewaySettings.ActiveRepoId;
            settingsSaved = false;
        }
    }

    private Task SaveSettingsAsync()
    {
        GatewaySettings.BaseUrl = settingsBaseUrl.Trim();
        GatewaySettings.ApiKey = settingsApiKey.Trim();
        GatewaySettings.ActiveRepoId = settingsRepoId.Trim();
        Preferences.Default.Set(BaseUrlPreferenceKey, GatewaySettings.BaseUrl);
        Preferences.Default.Set(ApiKeyPreferenceKey, GatewaySettings.ApiKey);
        Preferences.Default.Set(RepoIdPreferenceKey, GatewaySettings.ActiveRepoId);
        settingsSaved = true;
        return InvokeAsync(StateHasChanged);
    }

    private void NavigateHome()
    {
        NavManager.NavigateTo("/");
    }

    private void NavigateSmartInterview()
    {
        NavManager.NavigateTo("/smart-interview");
    }

    private void NavigateEngine()
    {
        NavManager.NavigateTo("/engine");
    }

    private void OpenProfile(GraphProfile profile)
    {
        NavManager.NavigateTo($"/chat/{profile.Id}");
    }

    private string GetNavClass(string uri)
    {
        string relative = NavManager.ToBaseRelativePath(NavManager.Uri);
        bool isActive = uri == "/"
            ? relative == string.Empty
            : relative.StartsWith(uri.TrimStart('/'), StringComparison.OrdinalIgnoreCase);
        return isActive ? "sidebar__menu-item sidebar__menu-item--active" : "sidebar__menu-item";
    }

    private static string GetProfileMeta(GraphProfile profile)
    {
        string date = profile.CreatedAt.ToLocalTime().ToString("d");
        return profile.DocumentCount > 0 ? $"{date} · {profile.DocumentCount} docs" : date;
    }

    private string GetStatusKind()
    {
        GatewayStatusDetails? status = ConnectionService.LastStatus;
        if (status == null)
        {
            return ConnectionService.ConnectionState == HubConnectionState.Connected ? "ready" : "offline";
        }

        return status.Status switch
        {
            GatewayOperationalStatus.Ready => "ready",
            GatewayOperationalStatus.Faulted => "error",
            GatewayOperationalStatus.Uninitialized => "offline",
            _ => "downloading"
        };
    }

    private string GetStatusIconClass()
    {
        return GetStatusKind() switch
        {
            "ready" => "system-status__icon system-status__icon--ready",
            "error" => "system-status__icon system-status__icon--error",
            "downloading" => "system-status__icon system-status__icon--downloading",
            _ => "system-status__icon system-status__icon--offline"
        };
    }

    private string GetStatusText()
    {
        GatewayStatusDetails? status = ConnectionService.LastStatus;
        if (status == null)
        {
            return ConnectionService.ConnectionState == HubConnectionState.Connected
                ? "Gateway Connected"
                : "Gateway Offline";
        }

        return status.Status switch
        {
            GatewayOperationalStatus.Ready => "Model Ready",
            GatewayOperationalStatus.ModelDownloading => "Downloading Model",
            GatewayOperationalStatus.ModelLoading => "Loading Model",
            GatewayOperationalStatus.Faulted => "Gateway Faulted",
            _ => status.Status.ToString()
        };
    }

    private string GetStatusValue()
    {
        GatewayStatusDetails? status = ConnectionService.LastStatus;
        if (status == null)
        {
            if (ConnectionService.ConnectionState == HubConnectionState.Connected)
            {
                return "Waiting for gateway telemetry...";
            }

            return ConnectionService.LastError ?? "Connecting...";
        }

        if (status.Status == GatewayOperationalStatus.Ready)
        {
            return status.ActiveModelId ?? "Active model loaded";
        }

        if (status.Status == GatewayOperationalStatus.Faulted)
        {
            return status.ErrorMessage ?? "Gateway reported a fault.";
        }

        if (status.Status == GatewayOperationalStatus.ModelDownloading)
        {
            return $"{GetDownloadPercent():F0}% · {status.StageDescription ?? "downloading weights"}";
        }

        return status.StageDescription ?? string.Empty;
    }

    private double GetDownloadPercent()
    {
        return ConnectionService.LastStatus?.ProgressPercentage ?? 0;
    }

    private bool ShowDownloadProgress()
    {
        GatewayStatusDetails? status = ConnectionService.LastStatus;
        return status != null
            && (status.Status == GatewayOperationalStatus.ModelDownloading
                || status.Status == GatewayOperationalStatus.ModelLoading)
            && GetDownloadPercent() < 100;
    }
}