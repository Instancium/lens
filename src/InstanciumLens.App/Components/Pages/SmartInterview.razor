@page "/smart-interview"
@inject NavigationManager NavigationManager

<div class="interview-layout">
    <!-- Top Bar: Context and Navigation -->
    <header class="interview-header">
        <button class="btn btn--ghost" @onclick="CancelAndReturn">
            <svg class="btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            Cancel & Return
        </button>
        <div class="interview-header__context">
            <span class="context-label">Target Folder:</span>
            <span class="context-path" title="@FolderPath">@GetShortPath(FolderPath)</span>
        </div>
    </header>

    <!-- Main Canvas: Conversation Area -->
    <main class="interview-canvas">
        <div class="chat-container">

            <!-- AI Greeting Message -->
            <div class="chat-message chat-message--system">
                <div class="chat-message__avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" />
                        <path d="M2 12h20M12 12v8" />
                    </svg>
                </div>
                <div class="chat-message__content">
                    <h2 class="chat-message__title">Smart Interview Initialization</h2>
                    <p class="chat-message__text">
                        I see you have loaded a new folder. To build a highly accurate knowledge graph, I need to understand your goals.
                        <strong>What exactly are we looking for in these documents?</strong>
                    </p>
                    <div class="chat-message__hint">
                        Example: "I need to find all pressure sensors, the equipment they are mounted on, and their GOST compliance."
                    </div>
                </div>
            </div>

            <!-- Future dynamic conversation and skeleton loaders will be rendered here -->

        </div>
    </main>

    <!-- Bottom Bar: User Input -->
    <footer class="interview-footer">
        <div class="input-wrapper">
            <textarea class="input-textarea"
                      placeholder="Describe your search intent in plain language..."
                      rows="3"
                      @bind="userIntentInput" 
                      @bind:event="oninput"></textarea>

            <button class="btn btn--primary btn--circle btn--send" disabled="@string.IsNullOrWhiteSpace(userIntentInput)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>
    </footer>
</div>

@code {
    [Inject] private InstanciumLens.Core.Interfaces.IAppStateService AppState { get; set; } = default!;
    
    private string? FolderPath => AppState.CurrentFolderPath;
    private string userIntentInput = string.Empty;

    private void CancelAndReturn()
    {
        NavigationManager.NavigateTo("/");
    }

    private string GetShortPath(string? path)
    {
        if (string.IsNullOrEmpty(path)) return "Unknown Folder";

        // Truncate long paths for the UI header to maintain clean design
        if (path.Length > 50)
        {
            var parts = path.Split(System.IO.Path.DirectorySeparatorChar);
            if (parts.Length > 2)
            {
                return $"{parts[0]}\\...\\{parts[^1]}";
            }
        }
        return path;
    }
}