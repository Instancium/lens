@page "/"
@using InstanciumLens.Core.Models
@using InstanciumLens.App.Components.Progress

@inject InstanciumLens.Core.Interfaces.IFolderPickerService FolderPickerService
@inject InstanciumLens.Core.Interfaces.IFolderAnalyzer FolderAnalyzer
@inject InstanciumLens.Core.Interfaces.IAppStateService AppState
@inject InstanciumLens.Core.Interfaces.IGraphRagManager GraphRagManager
@inject NavigationManager NavManager

<div class="dashboard-layout">
    <header class="dashboard-header">
        <div class="dashboard-header__title">
            <h1>Workspace</h1>
            @if (!string.IsNullOrEmpty(selectedFolderPath))
            {
                <p class="text-muted">@selectedFolderPath</p>
            }
        </div>
        <div class="dashboard-header__actions">
            <button class="btn btn--outline" @onclick="HandleFolderSelection" disabled="@isLoading">
                @(string.IsNullOrEmpty(selectedFolderPath) ? "Browse Folder" : "Change Folder")
            </button>
            @if (!string.IsNullOrEmpty(selectedFolderPath))
            {
                <button class="btn btn--primary" @onclick="CreateNewGraph" disabled="@isLoading">
                    + New Graph Profile
                </button>
            }
        </div>
    </header>

    @if (isLoading)
    {
        <div class="loading-state">
            <p>Scanning directory and reading configuration...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(selectedFolderPath))
    {
        <!-- Folder Statistics -->
        @if (folderStats != null)
        {
            <div class="folder-stats-banner">
                <span class="stat-item">📁 @folderStats.SubfolderCount subfolders</span>
                <span class="stat-item">📄 @folderStats.FileCount PDF files</span>
                <span class="stat-item">💾 @folderStats.FormattedSize</span>
            </div>
        }

        <!-- Knowledge Graphs Grid -->
        <div class="profiles-section">
            @if (graphs.Any())
            {
                <div class="profiles-grid">
                    @foreach (var profile in graphs)
                    {
                        <div class="profile-card">
                            <div class="profile-card__header">
                                <span class="profile-card__icon">@profile.Icon</span>
                                <h3 class="profile-card__title">@profile.DisplayName</h3>
                            </div>
                            <p class="profile-card__desc">@profile.Description</p>

                            <div class="profile-card__actions">
                                <button class="btn btn--ghost btn--small" @onclick="() => StartAnalysis(profile)">
                                    ▶ Build / Update Graph
                                </button>
                                <button class="btn btn--primary btn--small" @onclick="() => OpenChat(profile)">
                                    💬 Open Chat
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state__icon">🗂️</div>
                    <h3>No Knowledge Graphs Yet</h3>
                    <p class="text-muted">Click "New Graph Profile" to start the Smart Interview.</p>
                </div>
            }
        </div>
    }
    else
    {
        <div class="welcome-state">
            <h2>Welcome to Instancium Lens</h2>
            <p>Select a folder containing your PDF documents to begin offline analysis.</p>
        </div>
    }
</div>

<!-- ========================================== -->
<!-- 🚀 PROGRESS COMPONENT OVERLAY -->
<!-- ========================================== -->
<Progress State="@currentProcessingState" OnDismiss="ResetProgress" />

@code {
    private string? selectedFolderPath;
    private FolderStatistics? folderStats;
    private bool isLoading = false;
    private List<GraphProfile> graphs = new();

    // State for the Progress overlay component
    private ProcessingState currentProcessingState = new();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(AppState.CurrentFolderPath))
        {
            selectedFolderPath = AppState.CurrentFolderPath;
            isLoading = true;

            folderStats = await FolderAnalyzer.AnalyzeAsync(selectedFolderPath);
            await LoadGraphsFromManifest();

            isLoading = false;
        }
    }

    private async Task HandleFolderSelection()
    {
        var pickedPath = await FolderPickerService.PickFolderAsync();

        if (!string.IsNullOrEmpty(pickedPath) && pickedPath != selectedFolderPath)
        {
            isLoading = true;
            selectedFolderPath = pickedPath;
            folderStats = null;
            graphs.Clear();

            AppState.SetCurrentFolder(pickedPath);
            await InvokeAsync(StateHasChanged);

            folderStats = await FolderAnalyzer.AnalyzeAsync(pickedPath);
            await LoadGraphsFromManifest();

            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadGraphsFromManifest()
    {
        if (string.IsNullOrEmpty(selectedFolderPath)) return;

        try
        {
            string manifestPath = System.IO.Path.Combine(selectedFolderPath, ".instancium", "manifest.json");
            if (System.IO.File.Exists(manifestPath))
            {
                string json = await System.IO.File.ReadAllTextAsync(manifestPath);
                var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var manifest = System.Text.Json.JsonSerializer.Deserialize<FolderManifest>(json, options);
                graphs = manifest?.Profiles ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error reading manifest: {ex.Message}");
            graphs.Clear();
        }
    }

    private void CreateNewGraph()
    {
        NavManager.NavigateTo("/smart-interview");
    }

    private void OpenChat(GraphProfile profile)
    {
        // We will implement this route next
        NavManager.NavigateTo($"/chat/{profile.Id}");
    }

    // ==========================================
    // ANALYSIS ORCHESTRATION LOGIC
    // ==========================================
    private async Task StartAnalysis(GraphProfile profile)
    {
        if (string.IsNullOrEmpty(selectedFolderPath)) return;

        // 1. Initialize state to trigger the overlay
        currentProcessingState = new ProcessingState { CurrentPhase = ProcessingPhase.Pass1_TextExtraction };
        await InvokeAsync(StateHasChanged);

        try
        {
            // 2. Run the heavy analysis pipeline.
            // The callback instantly pushes state updates to the Progress component.
            await GraphRagManager.BuildGraphForFolderAsync(
                selectedFolderPath,
                profile,
                state =>
                {
                    currentProcessingState = state;
                    // Force Blazor UI thread to redraw the progress bar
                    InvokeAsync(StateHasChanged);
                });
        }
        catch (Exception ex)
        {
            currentProcessingState.CurrentPhase = ProcessingPhase.Error;
            currentProcessingState.StatusMessage = $"Analysis failed: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ResetProgress()
    {
        currentProcessingState = new ProcessingState(); // Reset to Idle
        StateHasChanged();
    }
}